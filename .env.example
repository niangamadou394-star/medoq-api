# ═══════════════════════════════════════════════════════════════
# MEDOQ — Variables d'environnement (Production sur Render)
# ═══════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL (Render) ────────────────────────
# Automatiquement renseigné par Render via render.yaml
# Pour le dev local : https://neon.tech (tier gratuit)
DATABASE_URL=postgresql://user:password@host/medoq

# ── Authentification JWT ───────────────────────────────────────
JWT_SECRET=changer-cette-valeur-OBLIGATOIREMENT-en-production
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# ── SMS Africa's Talking ───────────────────────────────────────
# 1. Créer un compte sur https://africastalking.com
# 2. App > API Key > copier la clé
# Sans ces valeurs : OTP affiché dans les logs Render uniquement
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=Medoq

# true en production (OTP SMS obligatoire)
OTP_REQUIRED=true

# ── Email notifications admin ──────────────────────────────────
# Gmail avec mot de passe d'application (pas votre vrai mdp)
# Compte Google > Securite > Mots de passe des applications > Medoq
SMTP_USER=niangamadou394@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ADMIN_EMAIL=niangamadou394@gmail.com

# ── Admin (1er compte admin) ───────────────────────────────────
# Choisir une valeur secrete, puis appeler :
#   POST /api/v1/admin/bootstrap
#   Header : x-admin-bootstrap: <ADMIN_BOOTSTRAP_SECRET>
#   Body   : { "phone": "+221XXXXXXXXX", "name": "Amadou Niang", "password": "..." }
ADMIN_BOOTSTRAP_SECRET=choisir-une-valeur-secrete

# ── Metier ─────────────────────────────────────────────────────
COMMISSION_RATE=1.5
RESERVATION_EXPIRY_HOURS=2
DELIVERY_FEE=1500

# ── Serveur ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
