# ── Base de données (Render PostgreSQL, obligatoire) ───────────────────────────
# Copier l'External Database URL depuis le dashboard Render (base medoq-db)
DATABASE_URL=postgresql://user:password@host/medoq

# ── Authentification ───────────────────────────────────────────────────────────
JWT_SECRET=changer-cette-valeur-par-une-chaine-longue-et-aleatoire
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# ── SMS Africa's Talking (production) ──────────────────────────────────────────
# Créer un compte sur https://africastalking.com puis une app "medoq"
# Sans ces valeurs, les codes OTP s'affichent dans les logs du serveur (mode dev)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=Medoq

# ── Vérification par SMS ───────────────────────────────────────────────────────
# true : le code SMS est exigé à l'inscription (production)
OTP_REQUIRED=false

# ── Métier ─────────────────────────────────────────────────────────────────────
COMMISSION_RATE=1.5
RESERVATION_EXPIRY_HOURS=2
DELIVERY_FEE=1500

# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
